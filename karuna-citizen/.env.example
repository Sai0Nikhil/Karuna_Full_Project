# Backend API URL
# For local development (optional - defaults to localhost:8081)
# VITE_API_URL=http://localhost:8081/api
# For production (set this in Vercel dashboard)
# VITE_API_URL=https://your-backend-name.onrender.com/api

# NGO Portal URL (set after deploying karuna-ngo on Vercel)
# VITE_NGO_URL=https://karuna-ngo.vercel.app
