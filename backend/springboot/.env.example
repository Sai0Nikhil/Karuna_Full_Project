# Spring runtime
SPRING_PROFILES_ACTIVE=dev
SPRING_APPLICATION_NAME=karuna-backend
SERVER_PORT=8081

# PostgreSQL
POSTGRES_URL=jdbc:postgresql://localhost:5432/karuna
POSTGRES_USERNAME=karuna
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DRIVER=org.postgresql.Driver

# MongoDB
MONGODB_URI=mongodb://localhost:27017/karuna

# JPA and Flyway
JPA_OPEN_IN_VIEW=false
JPA_HIBERNATE_DDL_AUTO=validate
JPA_SHOW_SQL=false
HIBERNATE_FORMAT_SQL=false
HIBERNATE_JDBC_TIME_ZONE=UTC
FLYWAY_ENABLED=true
FLYWAY_LOCATIONS=classpath:db/migration
FLYWAY_BASELINE_ON_MIGRATE=true

# Dev profile overrides
DEV_JPA_HIBERNATE_DDL_AUTO=validate
DEV_JPA_SHOW_SQL=true
DEV_HIBERNATE_FORMAT_SQL=true
DEV_FLYWAY_CLEAN_DISABLED=true
DEV_MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always
DEV_LOG_LEVEL_KARUNA=DEBUG
DEV_LOG_LEVEL_SPRING_SECURITY=INFO
DEV_LOG_LEVEL_HIBERNATE_SQL=DEBUG

# Production profile overrides
PROD_JPA_HIBERNATE_DDL_AUTO=validate
PROD_JPA_SHOW_SQL=false
PROD_HIBERNATE_FORMAT_SQL=false
PROD_FLYWAY_CLEAN_DISABLED=true
PROD_MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=never
PROD_LOG_LEVEL_ROOT=INFO
PROD_LOG_LEVEL_KARUNA=INFO
PROD_LOG_LEVEL_SPRING_SECURITY=WARN
PROD_LOG_LEVEL_HIBERNATE_SQL=WARN
PROD_SPRINGDOC_SWAGGER_UI_ENABLED=false

# Spring Security generated actuator user
ACTUATOR_USERNAME=actuator
ACTUATOR_PASSWORD=replace-with-a-strong-actuator-password
ACTUATOR_ROLES=ACTUATOR

# Actuator and Micrometer
MANAGEMENT_ENDPOINT_BASE_PATH=/actuator
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus
MANAGEMENT_ENDPOINT_HEALTH_PROBES_ENABLED=true
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=when_authorized
MANAGEMENT_ENDPOINT_PROMETHEUS_ENABLED=true
MANAGEMENT_INFO_ENV_ENABLED=true
MANAGEMENT_PROMETHEUS_METRICS_EXPORT_ENABLED=true

# Logging
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_KARUNA=INFO
LOG_LEVEL_SPRING_SECURITY=INFO
LOG_LEVEL_HIBERNATE_SQL=WARN

# Server error responses
SERVER_ERROR_INCLUDE_BINDING_ERRORS=never
SERVER_ERROR_INCLUDE_MESSAGE=never
SERVER_ERROR_INCLUDE_STACKTRACE=never
SERVER_ERROR_WHITELABEL_ENABLED=false

# CORS
KARUNA_CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002
KARUNA_CORS_ALLOWED_ORIGIN_PATTERNS=
KARUNA_CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
KARUNA_CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Request-Id
KARUNA_CORS_EXPOSED_HEADERS=X-Request-Id
KARUNA_CORS_ALLOW_CREDENTIALS=true
KARUNA_CORS_MAX_AGE=3600

# Cache
SPRING_CACHE_TYPE=simple
KARUNA_CACHE_NAMES=health,openapi

# OpenAPI and Swagger
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_API_DOCS_PATH=/v3/api-docs
SPRINGDOC_SWAGGER_UI_ENABLED=true
SPRINGDOC_SWAGGER_UI_PATH=/swagger-ui.html
SPRINGDOC_SWAGGER_UI_OPERATIONS_SORTER=method
SPRINGDOC_SWAGGER_UI_TAGS_SORTER=alpha
KARUNA_OPENAPI_TITLE=Karuna API
KARUNA_OPENAPI_DESCRIPTION=Infrastructure foundation for the Karuna backend API
KARUNA_OPENAPI_VERSION=1.0.0
KARUNA_OPENAPI_SERVER_URL=http://localhost:8081
KARUNA_OPENAPI_CONTACT_NAME=Karuna Team
KARUNA_OPENAPI_LICENSE_NAME=Internal project
KARUNA_OPENAPI_BEARER_AUTH_ENABLED=true

# WebSocket infrastructure
KARUNA_WEBSOCKET_ENDPOINT=/ws
KARUNA_WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002
KARUNA_WEBSOCKET_ALLOWED_ORIGIN_PATTERNS=

# JWT
KARUNA_JWT_SECRET=replace-with-at-least-32-random-characters
KARUNA_JWT_ACCESS_TOKEN_EXPIRATION=15m
KARUNA_JWT_REFRESH_TOKEN_EXPIRATION=7d
KARUNA_JWT_ISSUER=karuna-api
KARUNA_JWT_AUDIENCE=karuna-clients

# Password policy and account security
KARUNA_PASSWORD_MIN_LENGTH=8
KARUNA_PASSWORD_MAX_LENGTH=128
KARUNA_PASSWORD_REQUIRE_UPPERCASE=false
KARUNA_PASSWORD_REQUIRE_LOWERCASE=false
KARUNA_PASSWORD_REQUIRE_DIGIT=false
KARUNA_PASSWORD_REQUIRE_SPECIAL=false
KARUNA_LOGIN_MAX_FAILED_ATTEMPTS=5
KARUNA_LOGIN_LOCK_DURATION=15m
KARUNA_EMAIL_VERIFICATION_EXPIRATION=24h
KARUNA_PASSWORD_RESET_EXPIRATION=1h

# Optional AI provider keys used by existing health surfaces.

